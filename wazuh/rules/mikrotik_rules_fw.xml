<!--
  Reglas locales para MikroTik (firewall / perímetro). Versión en producción.
  Instalar en: /var/ossec/etc/rules/mikrotik_rules_fw.xml  (wazuh:wazuh, 660)

  EL NOMBRE DEL ARCHIVO IMPORTA: Wazuh carga las reglas en orden alfabético y estas
  dependen de la 100800 definida en mikrotik_rules.xml. Si este archivo se cargara antes,
  Wazuh avisaría "Signature ID '100800' was not found".
-->
<group name="mikrotik,firewall,">

  <rule id="100810" level="3">
    <if_sid>100800</if_sid>
    <match>WANIN-</match>
    <description>MikroTik: conexión nueva desde internet ($(srcip) hacia el puerto $(dstport)/$(protocol) por $(wan_link))</description>
    <group>recon,</group>
  </rule>

  <rule id="100811" level="8" frequency="10" timeframe="300">
    <if_matched_sid>100810</if_matched_sid>
    <same_source_ip />
    <description>MikroTik: la misma IP de internet insiste contra el router ($(srcip), 10 intentos en 5 minutos)</description>
    <group>recon,</group>
  </rule>

</group>
